# ---- ThreatLens backend configuration ----
# Copy this file to `.env` and fill in your own values.

# Application
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- VirusTotal ---
# https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# --- OpenRouter ---
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Primary model (free tier works). Any OpenRouter model id.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Ordered fallback chain for when the primary free model is overloaded.
# Accepts a JSON array or a comma-separated list of model ids.
OPENROUTER_FALLBACK_MODELS=["z-ai/glm-5.2:free","google/gemma-4-26b-a4b-it:free","thinkingmachines/inkling:free","deepseek/deepseek-v4-flash-0731:free"]
# Run the evidence-based AI interpretation on every analysis by default.
AI_ASSIST_DEFAULT=false

# --- Optional enrichment providers (all have free tiers) ---
# AbuseIPDB: https://www.abuseipdb.com/ -> Account API key
ABUSEIPDB_API_KEY=
# AlienVault OTX: https://otx.alienvault.com/ -> My settings > API
OTX_API_KEY=
# Time budget for the parallel enrichment fan-out (seconds).
ENRICHMENT_TIMEOUT_SECONDS=45

# --- Database ---
# SQLite (development)
DATABASE_URL=sqlite+aiosqlite:///./threatlens.db
# PostgreSQL / Supabase (production):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/threatlens

# --- Cache ---
CACHE_TTL_SECONDS=3600

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=32

# --- Background watchlist rescan (0 = disabled, on-demand only) ---
WATCHLIST_RESCAN_INTERVAL_SECONDS=0

# --- RBAC (opt-in) ---
# When true, clients send `X-ThreatLens-Role: viewer|analyst|admin`.
# Destructive endpoints (rescan all, delete case/rule) require `admin`.
RBAC_ENABLED=false

# --- CORS (JSON array of allowed origins) ---
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]