# ---- ThreatLens backend configuration ----
# Copy this file to `.env` and fill in your own values.

# Application
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- VirusTotal ---
# https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# --- OpenRouter ---
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
# Run the evidence-based AI interpretation on every analysis by default.
AI_ASSIST_DEFAULT=false

# --- Database ---
# SQLite (development)
DATABASE_URL=sqlite+aiosqlite:///./threatlens.db
# PostgreSQL / Supabase (production):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/threatlens

# --- Cache ---
CACHE_TTL_SECONDS=3600

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=32

# --- CORS (JSON array of allowed origins) ---
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]